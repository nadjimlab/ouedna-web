# Public Supabase values (required at build and runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side routing provider overrides
OSRM_SERVER_URL=
OSRM_FOOT_SERVER_URL=

# Server-only secret, if used by server routes/functions. Never expose it via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
